# Copy to .env for local development. Never commit .env (it is gitignored).
# Every credential the engine reads goes here; code resolves them via
# config.secret() (env var first, then Streamlit secrets).

# --- Paid APIs ---------------------------------------------------------------
# FantasyPros (player-projection priors) — https://www.fantasypros.com/apis/
FANTASYPROS_API_KEY=

# BettingPros (consensus props + open/close odds; partner key + account creds)
BP_PARTNER_KEY=
BP_USER=
BP_USER_KEY=

# The Odds API (multi-book lines / closing line — the CLV backbone)
# https://the-odds-api.com/
THE_ODDS_API_KEY=

# --- Free APIs ---------------------------------------------------------------
# CollegeFootballData (NCAAF EPA/PPA, SP+/FPI, returning production, talent,
# lines). Free key (1k calls/mo) at https://collegefootballdata.com/key
CFBD_API_KEY=
# nflverse play-by-play needs NO key (public release parquet).

# --- App / notifications -----------------------------------------------------
# Password for the Streamlit dashboard gate. Pick something long and random.
APP_PASSWORD=

# ntfy.sh push (new qualifying cards). Topic required; server/token optional.
NTFY_TOPIC=
NTFY_SERVER=
NTFY_TOKEN=
NTFY_CONFIRM_TOPIC=
